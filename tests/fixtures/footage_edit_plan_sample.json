  "transcript": [
    {
      "start": "00:00",
      "end": "00:02",
      "text": "Anh chị em nào đang bán hàng online mà muốn có một con chatbot AI tự trả lời khách hàng"
    },
    {
      "start": "00:02",
      "end": "00:05",
      "text": "tư vấn, chốt đơn luôn thì hãy xem hết video này."
    },
    {
      "start": "00:05",
      "end": "00:08",
      "text": "Mình làm nghề gì? Mình chuyên setup chatbot AI bán hàng."
    },
    {
      "start": "00:08",
      "end": "00:11",
      "text": "Hiểu đơn giản như thế này."
    },
    {
      "start": "00:11",
      "end": "00:14",
      "text": "Mình sẽ tạo cho anh chị em một con bot."
    },
    {
      "start": "00:14",
      "end": "00:18",
      "text": "Con bot này nó ngồi nó trả lời tin nhắn cho anh chị em 24/7, không bao giờ nghỉ."
    },
    {
      "start": "00:18",
      "end": "00:21",
      "text": "Mà nó không phải là loại chatbot cũ trả lời cứng ngắc đâu."
    },
    {
      "start": "00:21",
      "end": "00:24",
      "text": "Con này nó xài AI, nó vô cùng thông minh."
    },
    {
      "start": "00:24",
      "end": "00:27",
      "text": "Ví dụ nè, anh chị em có 500 cái sản phẩm, nó sẽ nhớ hết 500 cái sản phẩm đó."
    },
    {
      "start": "00:27",
      "end": "00:31",
      "text": "Khách hỏi, thỏi son này màu gì thì nó sẽ tư vấn được."
    },
    {
      "start": "00:31",
      "end": "00:35",
      "text": "Khách gửi cái hình cái váy đó qua và hỏi cái này còn không thì nó sẽ nhìn cái hình đó."
    },
    {
      "start": "00:35",
      "end": "00:38",
      "text": "Biết đó là sản phẩm váy nào, nó trả lời luôn."
    },
    {
      "start": "00:38",
      "end": "00:41",
      "text": "Hay hơn nữa, nó chốt đơn được luôn."
    },
    {
      "start": "00:41",
      "end": "00:45",
      "text": "Khách muốn mua, nó tự hỏi, chị ơi cho em xin địa chỉ số điện thoại."
    },
    {
      "start": "00:45",
      "end": "00:49",
      "text": "Thì nó sẽ tạo được đơn hàng, nó gom cái đơn hàng đó về một chỗ cho anh chị em mình."
    },
    {
      "start": "00:49",
      "end": "00:51",
      "text": "Anh chị em chỉ việc đóng gói, ship hàng đi thôi."
    },
    {
      "start": "00:51",
      "end": "00:54",
      "text": "Nghe thì hay đúng không? Mà anh chị em không cần biết gì về công nghệ đâu."
    },
    {
      "start": "00:54",
      "end": "00:58",
      "text": "Anh chị em chỉ cần đưa cho mình cái danh sách sản phẩm mà anh chị em có."
    },
    {
      "start": "00:58",
      "end": "01:02",
      "text": "Chỉ cho mình cách mà anh chị em muốn con bot nó hoạt động, nó chuyện với khách hàng như thế nào."
    },
    {
      "start": "01:02",
      "end": "01:06",
      "text": "Còn lại thì mình sẽ lo hết, mình sẽ hỗ trợ setup đến khi nào mà anh chị em ưng ý thì thôi."
    },
    {
      "start": "01:06",
      "end": "01:09",
      "text": "Anh chị em muốn coi thử con bot đó nó trả lời như thế nào thì hãy bấm ngay vào đường link bên dưới."
    },
    {
      "start": "01:09",
      "end": "01:13",
      "text": "Anh chị em cứ thoải mái trải nghiệm cái hệ thống con bot của mình đang hoạt động."
    },
    {
      "start": "01:13",
      "end": "01:18",
      "text": "Thấy ưng thì mình sẽ tạo cho anh chị em một con chatbot y chang như vậy nhưng mà với cái ngành hàng và sản phẩm của anh chị em muốn."
    }
  ],
