# OpenMontage - Environment Variables
# Copy this to .env and fill in your keys

# --- Image + video gateway ---
FAL_KEY=                     # FLUX images, Google Veo video, Kling video, MiniMax video, Recraft images
                             # Get one at https://fal.ai/dashboard/keys

# --- Google (one key unlocks image gen + TTS) ---
GOOGLE_API_KEY=              # Google Imagen images, Google Cloud TTS (700+ voices, 50+ languages)
                             # Get one at https://aistudio.google.com/apikey
# Alternative to the API key: service-account JSON auth.
# TTS uses Cloud Text-to-Speech; Imagen routes to Vertex AI.
GOOGLE_APPLICATION_CREDENTIALS=   # path to a service-account JSON key file
GOOGLE_CLOUD_PROJECT=             # GCP project id (required for Imagen via Vertex AI)
GOOGLE_CLOUD_LOCATION=            # Vertex AI region, default us-central1

# --- Voice ---
ELEVENLABS_API_KEY=          # TTS narration, music, sound effects — and Scribe v2 ASR,
                             # the default transcriber for the talking-head auto-editor.
                             # Unset: it falls back to local Whisper (slower, offline).
OPENAI_API_KEY=              # OpenAI TTS fallback and GPT Image 2 image generation
XAI_API_KEY=                 # Grok image generation/editing and Grok video generation
DOUBAO_SPEECH_API_KEY=       # Volcengine Doubao Speech TTS (new console API Key)
DOUBAO_SPEECH_VOICE_TYPE=    # Default Doubao speaker/voice type, e.g. zh_female_vv_uranus_bigtts
# Piper local voices do not require env vars; install `piper-tts` via pip

# --- Music ---
SUNO_API_KEY=                # Suno AI music generation (full songs, instrumentals, any genre)

# --- Video Generation ---
HEYGEN_API_KEY=              # HeyGen API (VEO, Sora, Runway, Kling, Seedance via single key)
RUNWAY_API_KEY=              # Runway Gen-4 (direct API, alternative to fal.ai routing)
VIDEO_GEN_LOCAL_ENABLED=     # Set to "true" for local video gen (needs GPU + diffusers)
VIDEO_GEN_LOCAL_MODEL=       # Local model: wan2.1-1.3b, wan2.1-14b, hunyuan-1.5, ltx2-local, cogvideo-5b
MODAL_LTX2_ENDPOINT_URL=    # Modal self-hosted LTX-2 endpoint (optional)

# --- Stock Media ---
PEXELS_API_KEY=              # Pexels stock footage/images (free)
PIXABAY_API_KEY=             # Pixabay stock footage/images (free)
UNSPLASH_ACCESS_KEY=         # Unsplash stock images (free developer key)

# --- Analysis ---
HF_TOKEN=                    # HuggingFace token — enables speaker diarization in transcriber

# --- Avatar (local installs) ---
# WAV2LIP_PATH=              # Path to cloned Wav2Lip repo (for lip sync)
# SADTALKER_PATH=            # Path to cloned SadTalker repo (for talking head avatars)

# --- Talking-head auto-edit (lib/talking_head_edit + web UI) ---
# The AI director runs through an OpenAI-compatible gateway, not a vendor SDK.
NINE_ROUTER_BASE_URL=        # e.g. https://<gateway>/v1
NINE_ROUTER_API_KEY=
AUTOEDIT_DIRECTOR_MODEL=ag/gemini-3.7-flash-high   # default director model (9router slug)
# Grok-4.5 defaults reasoning to high and can 524 on Cloudflare (~120s).
# low keeps structure/caption under the gateway read timeout.
AUTOEDIT_REASONING_EFFORT=low

# Folders the web UI is allowed to load footage from, separated by ";".
# Without this the server still accepts ~/Downloads, ~/Videos and projects/ —
# anything else returns 403 by design, since the API is unauthenticated.
# AUTOEDIT_INPUT_ROOTS=D:/footage;E:/quay

# AUTOEDIT_PORT=8861                 # API + media server
# AUTOEDIT_UI_PORT=5617              # Vite UI (not 5173 — that port is commonly taken)
# AUTOEDIT_API=http://127.0.0.1:8861 # Vite /api proxy target (loopback is fine even on a VPS)
# AUTOEDIT_BIND=0.0.0.0              # listen on all interfaces; default 127.0.0.1
# AUTOEDIT_PUBLIC_HOST=203.0.113.10  # VPS public IP/hostname — CORS + Vite HMR
# AUTOEDIT_CORS_ORIGINS=http://203.0.113.10:5617
# AUTOEDIT_PRICE_IN_PER_MTOK=0       # set both to see real cost per job in the UI
# AUTOEDIT_PRICE_OUT_PER_MTOK=0

# AUTOEDIT_API_TOKEN=                # unset = every /api/* request is open (the historical
                                     # behaviour). Set this to require
                                     # `Authorization: Bearer <token>` / `X-API-Key: <token>`
                                     # on every /api/* call, /openapi.json and /docs. A
                                     # browser instead logs in once (`POST /api/auth/login`)
                                     # for an HttpOnly session cookie; a <video src>/webhook
                                     # mp4_url gets a short-lived signed URL instead of the
                                     # raw token (see docs/talking-head-autoedit.md
                                     # §Automation API). GET /api/health always stays open.
# AUTOEDIT_MAX_DOWNLOAD_MB=2048      # cap for a `url` source POSTed to /api/runs
# AUTOEDIT_SIGNED_URL_TTL=86400       # seconds a signed media URL (mp4_url) stays valid
# AUTOEDIT_CPU_BUDGET=6               # cores the pipeline plans for; default 60% of
                                      # the cores this process may run on (min 2) —
                                      # this VPS's cores are shared with other projects
# AUTOEDIT_NICE=10                    # nice level for the pipeline subprocess; 0 = off

# --- Cloud render (lib/cloud_render/) ---
# Opt-in: rents a Vast.ai box for a render. Off by default -- see
# config/cloud-render.json's "enabled". Nothing here is required until that
# is flipped to true.
VAST_API_KEY=                # Vast.ai API key. If unset, the installed SDK
                             # (vastai==1.0.4) falls back to ~/.vast_api_key.
CLOUD_RENDER_SSH_KEY=         # Path to the dedicated cloud-render private key.
                             # Generate one with `python -m lib.cloud_render.setup_key`
                             # (default ~/.ssh/openmontage_cloud_render) -- do not
                             # reuse an existing Vast key here.
CLOUD_RENDER_MAX_DPH_USD=     # Optional override of config/cloud-render.json's
                             # max_dph_usd ceiling (not yet wired into config.py --
                             # reserved for a later phase).

# --- Cloudflare R2 (object storage for project assets) ---
CLOUDFLARE_R2_ACCOUNT_ID=          # Cloudflare account id (subdomain of the R2 endpoint URL)
CLOUDFLARE_R2_ACCESS_KEY_ID=       # S3-compatible access key, from R2 > Manage API Tokens
CLOUDFLARE_R2_SECRET_ACCESS_KEY=   # S3-compatible secret key (shown once at creation)
CLOUDFLARE_R2_ENDPOINT_URL=        # https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=              # Bucket name -- create it in the Cloudflare dashboard first
CLOUDFLARE_R2_API_TOKEN=           # Cloudflare API token (bucket admin); not used by the boto3 S3 client
CLOUDFLARE_R2_PUBLIC_BASE_URL=     # https://<custom-domain> hoặc Public Development URL của bucket; trống = chỉ dùng presigned URL
